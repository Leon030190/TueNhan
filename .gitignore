# Git ignore file for TueNhan repository

# Large executables and raw packages (exceeding GitHub file limit or redundant)
*.exe
*.pck
*.zip
*.apk
*.aab
build_android/
godot_bin/
__pycache__/
*.pyc

# Godot Editor cache
.godot/editor/
.godot/imported/*.md5
.godot/.gdignore
.godot/uid_cache.bin
.godot/exported/

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files
*.tmp
*.log


